+  }
+  
+  const fieldFns = customOnChange.value?.[fieldname];
+  if (fieldFns) {
+    fieldFns.forEach((fn: Function) => {
+      try {
+        fn(newValue, fieldtype);
+      } catch (e) {
+        console.error("Error in custom onChange:", e);
+      }
+    });
+  }
+}
