  "modified": "2026-04-29 08:34:42.881237",
  "module": "Test App",
  "name": "Custom Ticket Report",
  "prepared_report": 1,
  "query": "SELECT\n    name AS \"Ticket ID:Link/HD Ticket\",\n    subject AS \"Subject\",\n    status AS \"Status\",\n    priority AS \"Priority\",\n    owner AS \"Owner:Link/User\",\n    agent_group AS \"Agent Group:Link/HD Team\",\n    customer_name AS \"Customer Name:Link/HD Customer\"\nFROM\n    `tabHD Ticket`\nLEFT JOIN\n    `tabCustomer Name` ON `tabHD Ticket`.custom_customer_name = `tabCustomer Name`.name\nWHERE\n    `tabHD Ticket`.docstatus < 2\n    AND (IFNULL(%(status)s, '') = '' OR `tabHD Ticket`.status = %(status)s)\n    AND (IFNULL(%(customer_name)s, '') = '' OR `tabHD Ticket`.custom_customer_name = %(customer_name)s)\n\n",
  "ref_doctype": "HD Ticket",
  "reference_report": null,
  "report_name": "Custom Ticket Report",
  "report_script": "def execute(filters=None):\n    columns = [\n        {\"label\": \"Ticket ID\", \"fieldname\": \"name\", \"fieldtype\": \"Link\", \"options\": \"HD Ticket\", \"width\": 120},\n        {\"label\": \"Subject\", \"fieldname\": \"subject\", \"fieldtype\": \"Data\", \"width\": 200},\n        {\"label\": \"Status\", \"fieldname\": \"status\", \"fieldtype\": \"Select\", \"width\": 100},\n        {\"label\": \"Customer Name\", \"fieldname\": \"custom_customer_name\", \"fieldtype\": \"Link\", \"options\": \"HD Customer\", \"width\": 180},\n    ]\n\n    data = frappe.get_all(\n        \"HD Ticket\",\n        fields=[\"name\", \"subject\", \"status\", \"custom_customer_name\"],\n    )\n    return columns, data\n",
  "report_type": "Script Report",
